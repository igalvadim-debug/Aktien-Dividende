<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Панель Акций — Stock Dashboard</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0d1117; color: #e6edf3; min-height: 100vh; padding: 2rem; }
        h1 { font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; background: linear-gradient(90deg, #58a6ff, #a371f7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .subtitle { color: #8b949e; margin-bottom: 2rem; font-size: 1.1rem; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
        .card { background: #161b22; border: 1px solid #30363d; border-radius: 12px; padding: 1.25rem; display: flex; align-items: center; gap: 1rem; cursor: pointer; transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s; }
        .card:hover { transform: translateY(-2px); border-color: #58a6ff; box-shadow: 0 8px 24px rgba(88,166,255,0.15); }
        .icon { width: 48px; height: 48px; border-radius: 8px; object-fit: contain; background: #0d1117; }
        .icon.placeholder { width: 48px; height: 48px; border-radius: 8px; background: linear-gradient(135deg, #21262d, #30363d); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem; color: #58a6ff; }
        .info { flex: 1; min-width: 0; }
        .info h3 { font-size: 1rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .ticker { font-size: 0.8rem; color: #8b949e; font-family: 'SF Mono', monospace; }
        .loading { text-align: center; padding: 3rem; color: #8b949e; }
        .spinner { border: 3px solid #30363d; border-top-color: #58a6ff; border-radius: 50%; width: 32px; height: 32px; animation: spin 1s linear infinite; margin: 0 auto 1rem; }
        @keyframes spin { to { transform: rotate(360deg); } }
        footer { margin-top: 3rem; text-align: center; color: #484f58; font-size: 0.85rem; }
    </style>
</head>
<body>
    <header>
        <h1>Панель Акций — Stock Dashboard</h1>
        <p class="subtitle">{count} позиций — нажмите на любую карточку для подробного анализа на русском языке</p>
    </header>
    <main>
        <div class="grid" id="grid">
            {cards}
        </div>
        <div class="loading" id="loading" style="display:none;">
            <div class="spinner"></div>
            <p>Загружаем живые данные и создаем подробный отчет на русском языке...</p>
        </div>
    </main>
    <footer>Данные: Finnhub, Tavily, Yahoo Finance · Без галлюцинаций — только реальные факты из источников</footer>
    <script>
        document.querySelectorAll('.card').forEach(card => {
            card.addEventListener('click', async () => {
                const ticker = card.dataset.ticker;
                document.getElementById('grid').style.display = 'none';
                document.getElementById('loading').style.display = 'block';
                try {
                    const resp = await fetch('/api/stock/' + encodeURIComponent(ticker));
                    const data = await resp.json();
                    const win = window.open('', '_blank');
                    if (!win) {
                        alert('Всплывающее окно заблокировано! Разрешите всплывающие окна для этого сайта и попробуйте снова.');
                        return;
                    }
                    win.document.write(buildReportPage(data));
                    win.document.close();
                } catch (e) {
                    alert('Ошибка: ' + e.message);
                } finally {
                    document.getElementById('grid').style.display = 'grid';
                    document.getElementById('loading').style.display = 'none';
                }
            });
        });

        function buildReportPage(d) {
            const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            return `<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>${esc(d.ticker)} — Подробный Анализ на Русском</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0d1117; color: #e6edf3; line-height: 1.8; padding: 2rem; max-width: 900px; margin: 0 auto; }
        header { margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #30363d; }
        h1 { font-size: 2rem; font-weight: 700; }
        .meta { display: flex; gap: 1.5rem; margin-top: 0.5rem; color: #8b949e; font-size: 0.9rem; }
        section { margin-bottom: 2rem; }
        h2 { font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem; }
        h2::before { content: ''; width: 4px; height: 1.25rem; background: #58a6ff; border-radius: 2px; }
        p { color: #c9d1d9; margin-bottom: 1rem; }
        .sources { font-size: 0.8rem; color: #6e7681; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid #30363d; }
        .badge { display: inline-block; background: #21262d; border: 1px solid #30363d; padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.75rem; margin-right: 0.5rem; }
    </style>
</head>
<body>
    <header>
        <h1>${esc(d.name)} (${esc(d.ticker)})</h1>
        <div class="meta">
            <span>Создано: ${new Date().toLocaleString('ru-RU')}</span>
            <span>Источники: ${d.sources.finnhub_profile ? 'Профиль компании' : ''} ${d.sources.finnhub_news_count ? d.sources.finnhub_news_count + ' новостей' : ''} ${d.sources.tavily_results ? d.sources.tavily_results + ' веб-статей' : ''} ${d.sources.yfinance_quote ? 'Котировка Yahoo Finance' : ''}
        </div>
    </header>
    <section>
        <h2>Обзор Бизнеса — Что Делает Компания</h2>
        <p>${esc(d.business)}</p>
    </section>
    <section>
        <h2>Анализ Акции — Текущее Состояние</h2>
        <p>${esc(d.analysis)}</p>
    </section>
    <section>
        <h2>Прогноз и Перспективы — Что Ждать Впереди</h2>
        <p>${esc(d.forecast)}</p>
    </section>
    <div class="sources">
        <span class="badge">Основано только на живых API данных</span>
        <span class="badge">Нет галлюцинаций ИИ</span>
        <span class="badge">Finnhub + Tavily + Yahoo Finance</span>
    </div>
</body>
</html>`;
        }
    </script>
</body>
</html>