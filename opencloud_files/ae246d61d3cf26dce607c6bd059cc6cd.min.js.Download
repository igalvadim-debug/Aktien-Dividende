(function(Drupal){Drupal.behaviors.mailboxMtmTracking={attach:function(context,settings){const trackingParams=["ncam","nkwd","ncon","ngrp","nmed","npla","nsrc","ncid",];function getTrackingParams(){const urlParams=new URLSearchParams(window.location.search);const result={};trackingParams.forEach((param)=>{const value=urlParams.get(param);if(value!==null){result[param]=value}});return result}
function appendTrackingParamsToUrl(url,params){try{const newUrl=new URL(url,window.location.origin);Object.entries(params).forEach(([key,value])=>{newUrl.searchParams.set(key,value)});return newUrl.toString()}catch(e){return url}}
function updateLinks(params){Array.from(document.links).forEach((link)=>{if(!context.contains(link))return;const href=link.getAttribute("href");if(link.protocol.startsWith("http")&&link.hostname.includes("mailbox")&&!link.getAttribute("href").startsWith("#")){const updatedUrl=appendTrackingParamsToUrl(link.href,params);link.setAttribute("href",updatedUrl)}})}
function updateForms(params){const registerForms=context.querySelectorAll('form[action*="register.mailbox.org"]',);registerForms.forEach((form)=>{Object.entries(params).forEach(([key,value])=>{if(!form.querySelector(`input[name="${key}"]`)){const input=document.createElement("input");input.type="hidden";input.name=key;input.value=value;form.appendChild(input)}})});const utfFields=context.querySelectorAll('[name="mtm"], [name="mtm[0][value]"]',);utfFields.forEach((input)=>{if(input.value===""){const newValue=[];Object.keys(params).map(function(key){newValue.push(`${key}: ${params[key]}`)});input.value=newValue.join("\n")}});trackingParams.forEach((name)=>{const field=context.querySelector(`[name="${name}"], [name="${name}[0][value]"]`,);field.value=params[name]})}
function updateIframes(params){const iframes=context.querySelectorAll('iframe[src*="form.mailbox.org"]',);iframes.forEach((iframe)=>{const src=iframe.getAttribute("src");if(src){const updatedSrc=appendTrackingParamsToUrl(src,params);iframe.setAttribute("src",updatedSrc)}})}
const trackingValues=getTrackingParams();if(Object.keys(trackingValues).length>0){updateLinks(trackingValues);updateForms(trackingValues);updateIframes(trackingValues)}},}})(Drupal)