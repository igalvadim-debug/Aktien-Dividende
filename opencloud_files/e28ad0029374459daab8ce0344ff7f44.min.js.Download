(function($){'use strict';Drupal.behaviors.cloudy__mega_menu=createLOOMComponent('mega-menu',function(){var that=this;var isopened=!1;var openitem=null;this.element('overlay').removeAttr('hidden');this.element('main-item').on('mouseenter',function(){openitem=$(this);if(isopened){that.element('main-item--hover').removeClass('mega-menu__main-item--hover');openitem.addClass('mega-menu__main-item--hover')}else{openitem.addClass('mega-menu__main-item--hover');isopened=!0}});this.element('links').on('mouseleave',function(){if(openitem)openitem.removeClass('mega-menu__main-item--hover');isopened=!1})})})(jQuery)