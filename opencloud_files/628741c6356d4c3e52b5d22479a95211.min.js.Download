(function(){'use strict';var script={SELECTOR:'.listview',VIEW_SELECTOR:'.listview__view',INDEX_SELECTOR:'.listview__view--index',HEADER_SELECTOR:'.listview__header',FLOATING_CLASS:'listview__header--floating',instance:null,views:null,current:null,last:null,attach:function(context){var views=context.querySelectorAll(script.SELECTOR);for(var index in views){if(!views.hasOwnProperty(index))continue;var element=views[index];script.instance=element;script.views=element.querySelectorAll(script.VIEW_SELECTOR);script.initFloating();script.initHiding();script.initHistoryPopping();script.current=element.querySelector('.listview__view--root')}},initFloating:function(){for(var index in script.views){if(!script.views.hasOwnProperty(index))continue;var view=script.views[index];var header=view.querySelector(script.HEADER_SELECTOR);if(header){(function(view,header){view.addEventListener('scroll',function(){if(view.scrollTop>0){header.classList.add(script.FLOATING_CLASS)}else{header.classList.remove(script.FLOATING_CLASS)}})})(view,header)}}},initHistoryPopping:function(){window.addEventListener('popstate',function(event){if(event.state&&event.state.listView){script.goto(event.state.listView,'')}})},initHiding:function(){var hashlinks=document.querySelectorAll(script.SELECTOR+' a[href^="#listview-"]');for(var index in hashlinks){if(!hashlinks.hasOwnProperty(index))continue;var link=hashlinks[index];if(!link.listViewProcessed){link.listViewProcessed=!0;(function(link){link.addEventListener('click',function(e){e.preventDefault();script.current=script.getView(link);if(link.classList.contains('listview__link--back')){history.back()}else{var targetSelector=link.getAttribute('href');var text=link.innerText;script.goto(targetSelector,text,!0)}})})(link)}}},goto:function(targetSelector,text,push){push=(push===undefined?!1:push);if(script.current.classList.contains('listview__view--root')){var rootSelector='#'+script.current.getAttribute('id');history.replaceState({listView:rootSelector},'',rootSelector)}
for(var index in script.views){if(!script.views.hasOwnProperty(index))continue;var view=script.views[index];if(view.matches(targetSelector)||view==script.current){view.removeAttribute('hidden')}else{view.setAttribute('hidden','hidden')}}
script.instance.style.scrollBehavior='auto';window.location.hash='#'+script.current.getAttribute('id');script.instance.scrollLeft=script.current.offsetLeft;setTimeout(function(){script.last=script.current;script.current=script.instance.querySelector(targetSelector);script.instance.style.scrollBehavior='';setTimeout(function(){script.instance.scrollLeft=script.current.offsetLeft;if(push){history.pushState({listView:targetSelector},text,targetSelector)}
script.hideWhenDone(script.last,script.current)},1)},1)},hideWhenDone:function(last,dest){setTimeout(function(){last.setAttribute('hidden',!0)},500)},getView:function(elem){for(;elem&&elem!==document;elem=elem.parentNode){if(elem.classList.contains('listview__view')){return elem}}
return null},};Drupal.behaviors.cloudy__listview=script})()