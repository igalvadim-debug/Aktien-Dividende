(function($){'use strict';Drupal.behaviors.cloudy__headarea=createLOOMComponent('headarea',function(){var that=this;var W=$(window);var sheet=$('.sheet');var menu=this.find('.mega-menu');var body=$('body');var hoverableClasses={'mega-menu--white':menu.hasClass('mega-menu--white'),'mega-menu--dark':menu.hasClass('mega-menu--dark'),'mega-menu--onmood':menu.hasClass('mega-menu--onmood'),'mega-menu--highlighted':menu.hasClass('mega-menu--highlighted'),};var searchForm=body.find('.course-search');menu.find('.mega-menu__main-item').on('mouseover',function(){that.state('hover',!0);for(var index in hoverableClasses){if(hoverableClasses[index]){menu.removeClass(index)}}
searchForm.addClass('course-search--humble')}).on('mouseout',function(){that.state('hover',!1);for(var index in hoverableClasses){if(hoverableClasses[index]){menu.addClass(index)}}
searchForm.removeClass('course-search--humble')});this.find('.headarea__toggler').on('change',function(){body.toggleClass('stuck')});var scrollbefore=0;var scrollAction=function(){var current=W.scrollTop();var moodline=that.item.height();if(current<1){that.state('motion',!1)}else{that.state('motion',!0)}
if(current<scrollbefore||current<moodline){that.state('proud',!0);that.state('shy',!1);sheet.addClass('sheet--headarea-proud').removeClass('sheet--headarea-shy')}else{that.state('proud',!1);that.state('shy',!0);sheet.addClass('sheet--headarea-shy').removeClass('sheet--headarea-proud')}
scrollbefore=current};W.scroll(scrollAction);setTimeout(scrollAction,100)})})(jQuery)