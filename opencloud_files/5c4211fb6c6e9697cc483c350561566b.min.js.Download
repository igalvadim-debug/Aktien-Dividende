(function($){Drupal.behaviors.cloudy__button=createLOOMComponent('button',function(){var that=this;var input=this.element('input');if(input.prop('disabled')){this.item.addClass('button--disabled')}
if(input.length){var observer=new MutationObserver(function(mutations){mutations.forEach(function(mutation){if(mutation.attributeName==='disabled'){if(input.prop('disabled')){that.item.addClass('button--disabled')}else{that.item.removeClass('button--disabled')}}})});observer.observe(input.get(0),{attributes:!0,})}})})(jQuery)